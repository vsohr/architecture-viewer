{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2022"],
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "composite": true,
        "incremental": true,
        "tsBuildInfoFile": "./node_modules/.cache/tsbuildinfo/node.tsbuildinfo",
        "types": ["node"]
    },
    "include": [
        "src/main/**/*.ts",
        "src/preload/**/*.ts",
        "tests/e2e/**/*.ts",
        "electron.vite.config.ts",
        "playwright.config.ts",
        "vitest.config.ts"
    ]
}
